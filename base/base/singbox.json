{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "disabled": false,
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "type": "https",
                "tag": "dns_cn",
                "server": "223.5.5.5",
                "server_port": 443,
                "path": "/dns-query",
                "tls": {
                    "enabled": true,
                    "server_name": "dns.alidns.com"
                }
            },
            {
                "type": "https",
                "tag": "dns_global",
                "server": "1.1.1.1",
                "server_port": 443,
                "path": "/dns-query",
                "tls": {
                    "enabled": true,
                    "server_name": "cloudflare-dns.com"
                },
                "detour": "🚀 节点选择"
            },
            {
                "type": "fakeip",
                "tag": "dns_fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            },
            {
                "type": "udp",
                "tag": "dns_resolver",
                "server": "223.5.5.5"
            }
        ],
        "rules": [],
        "final": "dns_global",
        "strategy": "prefer_ipv4",
        "reverse_mapping": true
    },
    "ntp": {
        "enabled": true,
        "server": "time.apple.com",
        "server_port": 123,
        "interval": "30m",
        "detour": "DIRECT"
    },
    "inbounds": [
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "0.0.0.0",
            "listen_port": 2080
        },
        {
            "type": "tun",
            "tag": "tun-in",
            "address": [
                "172.19.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "strict_route": true,
            "dns_mode": "hijack",
            "stack": "mixed"
        }
    ],
    "outbounds": [],
    "route": {
        "rules": [],
        "default_domain_resolver": "dns_resolver",
        "auto_detect_interface": true
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true
        },
        "clash_api": {
            "external_controller": "127.0.0.1:9090",
            "external_ui": "dashboard"
        }
    }
}
